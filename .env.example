# Copy to .env and fill in. docker compose reads .env from this directory and passes
# the values listed in docker-compose.yml; `uv run --env-file .env` reads it directly.
# Placeholders only: never commit a real .env (it's gitignored).
# A blank value counts as unset. Full table: docs/DEPLOYMENT.md, Variables.

# --- Required ---

# YNAB personal access token (YNAB → Account Settings → Developer Settings). Secret.
YNAB_API_TOKEN=your-ynab-personal-access-token

# Apprise URLs for alerts, separated by commas, semicolons or spaces. Each must load in
# Apprise or the app refuses to start. Secret: the URLs carry credentials.
# See https://github.com/caronc/apprise/wiki. Examples:
#   ntfy://ntfy.sh/your-topic
#   tgram://123456789:bot-token/chat-id
#   discord://webhook-id/webhook-token
APPRISE_URLS=ntfy://ntfy.sh/your-topic

# --- Accounts: set YNAB_ACCOUNT_ID_CC and/or YNAB_ACCOUNT_ID_NO_CC, or YNAB_ACCOUNT_ID ---

# id:threshold pairs, comma-separated. The threshold is in whole dollars (default 0).
# _CC: credit card payment balances are counted against the account (the account
# that pays your cards). _NO_CC: they aren't.
YNAB_ACCOUNT_ID_CC=your-checking-account-id:500
# YNAB_ACCOUNT_ID_NO_CC=your-other-account-id:100,another-account-id

# Older form, only when neither variable above is set: one account ID, CC payments
# counted, with its threshold in MIN_BALANCE (whole dollars, default 0). MIN_BALANCE is
# ignored with the newer form.
# YNAB_ACCOUNT_ID=your-checking-account-id
# MIN_BALANCE=500

# --- Optional ---

# Budget to read; default last-used.
# YNAB_BUDGET_ID=your-budget-id

# Credit card payment categories to count, by ID or name, comma-separated. Default: all
# in the "Credit Card Payments" group.
# YNAB_CC_CATEGORIES=Example Card,Store Card

# Days to project ahead (0 or more). Default: through the end of the current month.
# MONITOR_DAYS=30

# When to check. HH:MM (24h) runs daily at that time in TZ; Nh runs every N hours
# (0.1 to 8760) and starts with a check. With SCHEDULE and UPDATE_SCHEDULE both empty,
# the app runs one check and exits.
# SCHEDULE=08:00

# When routine update notifications go out, same format. Each one also checks the
# threshold. Without it, every scheduled check sends an update.
# UPDATE_SCHEDULE=18:00

# Apprise URLs for updates, same format and boot check. Default: APPRISE_URLS.
# Failure and recovery notices always go to APPRISE_URLS. Secret.
# UPDATE_APPRISE_URLS=ntfy://ntfy.sh/your-low-priority-topic

# Time zone for daily schedules and for "today"; compose defaults it to UTC.
# TZ=America/New_York

# Read by compose only, not the app: run another image tag (a rollback).
# APP_IMAGE=ghcr.io/john-fleischauer/ynab-balance-monitor:sha-abc1234
